{
  "name": "@cheqd/mcp-toolkit-studio",
  "version": "1.5.0",
  "packageManager": "pnpm@9.1.3",
  "description": "MCP Toolkit for cheqd studio (studio.cheqd.net)",
  "author": "Cheqd Foundation Limited (https://github.com/cheqd)",
  "license": "Apache-2.0",
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "type": "module",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "rm -rf build && tsc && chmod +x build/*.js",
    "start": "node build/index.js",
    "watch": "tsc --watch",
    "clean": "rm -rf ./build",
    "format": "prettier --config ../../.prettierrc.json --write 'src/**/*.{js,ts,cjs,mjs,json}'",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "cheqd",
    "mcp-toolkit",
    "mcp",
    "cheqd-studio"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
